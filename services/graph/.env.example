# Shared secret the web app sends in X-API-Key. Use a long random value outside local dev.
GRAPH_API_KEY=dev-key
# Serve interactive API docs at /docs (local development only).
# EXPOSE_DOCS=true
# Graph seed source. Normal runs read the collections the API seeds into MongoDB:
MONGO_URL=mongodb://localhost:27017
MONGO_DB=procurement
# Without MongoDB, point SEED_DIR at a directory of seed JSON (the test fixture works):
# SEED_DIR=tests/fixtures/seed
