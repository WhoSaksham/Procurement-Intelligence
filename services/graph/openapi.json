{
  "openapi": "3.1.0",
  "info": {
    "title": "Procurement graph service",
    "summary": "Knowledge graph, supplier resolution and provenance built with Semantica.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/graph": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Graph",
        "operationId": "graph_v1_graph_get",
        "parameters": [
          {
            "name": "focus",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "C1",
              "title": "Focus"
            }
          },
          {
            "name": "hops",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 4,
              "minimum": 1,
              "default": 2,
              "title": "Hops"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/full": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Full",
        "operationId": "full_v1_full_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/nodes/{node_id}": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Node",
        "operationId": "node_v1_nodes__node_id__get",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Node Id"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/suppliers/clusters": {
      "get": {
        "tags": [
          "suppliers"
        ],
        "summary": "Clusters",
        "operationId": "clusters_v1_suppliers_clusters_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SupplierCluster"
                  },
                  "title": "Response Clusters V1 Suppliers Clusters Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/suppliers/resolve": {
      "post": {
        "tags": [
          "suppliers"
        ],
        "summary": "Resolve",
        "operationId": "resolve_v1_suppliers_resolve_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Resolution"
                  },
                  "title": "Response Resolve V1 Suppliers Resolve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Analytics",
        "operationId": "analytics_v1_analytics_get",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analytics"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analytics": {
        "properties": {
          "centrality": {
            "items": {
              "$ref": "#/components/schemas/CentralityScore"
            },
            "type": "array",
            "title": "Centrality"
          },
          "communities": {
            "items": {
              "$ref": "#/components/schemas/CommunityAssignment"
            },
            "type": "array",
            "title": "Communities"
          },
          "modularity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Modularity"
          }
        },
        "type": "object",
        "required": [
          "centrality",
          "communities"
        ],
        "title": "Analytics"
      },
      "Candidate": {
        "properties": {
          "canonical_id": {
            "type": "string",
            "title": "Canonical Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "canonical_id",
          "name",
          "score"
        ],
        "title": "Candidate"
      },
      "CentralityScore": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "score"
        ],
        "title": "CentralityScore"
      },
      "CommunityAssignment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "community": {
            "type": "integer",
            "title": "Community"
          }
        },
        "type": "object",
        "required": [
          "id",
          "community"
        ],
        "title": "CommunityAssignment"
      },
      "Edge": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "relation": {
            "type": "string",
            "title": "Relation"
          },
          "basis": {
            "type": "string",
            "title": "Basis",
            "description": "How the link was made: shared key or scored match"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id",
            "description": "Evidence source the link came from"
          }
        },
        "type": "object",
        "required": [
          "source",
          "target",
          "relation",
          "basis",
          "confidence",
          "source_id"
        ],
        "title": "Edge"
      },
      "GraphResponse": {
        "properties": {
          "focus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/Node"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "type": "object",
        "required": [
          "focus",
          "nodes",
          "edges"
        ],
        "title": "GraphResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "semantica_version": {
            "type": "string",
            "title": "Semantica Version"
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          }
        },
        "type": "object",
        "required": [
          "status",
          "semantica_version",
          "stats"
        ],
        "title": "Health"
      },
      "JvLink": {
        "properties": {
          "jv_id": {
            "type": "string",
            "title": "Jv Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "lead",
              "member"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "jv_id",
          "role"
        ],
        "title": "JvLink"
      },
      "Node": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "layer": {
            "type": "string",
            "enum": [
              "ledger",
              "procedure",
              "retrospective",
              "context"
            ],
            "title": "Layer"
          },
          "attrs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Attrs"
          },
          "column": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Column",
            "description": "Layout column by entity type"
          },
          "row": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Row",
            "description": "Layout row within the column"
          },
          "centrality": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Centrality",
            "description": "Degree centrality, normalised to the most connected node"
          },
          "community": {
            "type": "integer",
            "title": "Community"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "layer",
          "attrs",
          "column",
          "row",
          "centrality",
          "community"
        ],
        "title": "Node"
      },
      "NodeDetail": {
        "properties": {
          "node": {
            "$ref": "#/components/schemas/Node"
          },
          "neighbours": {
            "items": {
              "$ref": "#/components/schemas/Edge"
            },
            "type": "array",
            "title": "Neighbours"
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/ProvenanceRecord"
            },
            "type": "array",
            "title": "Provenance"
          }
        },
        "type": "object",
        "required": [
          "node",
          "neighbours",
          "provenance"
        ],
        "title": "NodeDetail"
      },
      "ProvenanceRecord": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locator"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "activity": {
            "type": "string",
            "title": "Activity"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "recorded_at": {
            "type": "string",
            "title": "Recorded At"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "locator",
          "activity",
          "confidence",
          "recorded_at"
        ],
        "title": "ProvenanceRecord"
      },
      "Resolution": {
        "properties": {
          "input": {
            "type": "string",
            "title": "Input"
          },
          "canonical_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          }
        },
        "type": "object",
        "required": [
          "input",
          "canonical_id",
          "name",
          "score",
          "candidates"
        ],
        "title": "Resolution"
      },
      "ResolveRequest": {
        "properties": {
          "names": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Names"
          }
        },
        "type": "object",
        "required": [
          "names"
        ],
        "title": "ResolveRequest"
      },
      "Stats": {
        "properties": {
          "nodes": {
            "type": "integer",
            "title": "Nodes"
          },
          "edges": {
            "type": "integer",
            "title": "Edges"
          },
          "suppliers_raw": {
            "type": "integer",
            "title": "Suppliers Raw"
          },
          "suppliers_canonical": {
            "type": "integer",
            "title": "Suppliers Canonical"
          },
          "joint_ventures": {
            "type": "integer",
            "title": "Joint Ventures"
          },
          "merges": {
            "type": "integer",
            "title": "Merges"
          },
          "build_ms": {
            "type": "integer",
            "title": "Build Ms"
          },
          "semantica_version": {
            "type": "string",
            "title": "Semantica Version"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "edges",
          "suppliers_raw",
          "suppliers_canonical",
          "joint_ventures",
          "merges",
          "build_ms",
          "semantica_version"
        ],
        "title": "Stats"
      },
      "SupplierCluster": {
        "properties": {
          "canonical_id": {
            "type": "string",
            "title": "Canonical Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/Variant"
            },
            "type": "array",
            "title": "Variants"
          },
          "jv_links": {
            "items": {
              "$ref": "#/components/schemas/JvLink"
            },
            "type": "array",
            "title": "Jv Links"
          }
        },
        "type": "object",
        "required": [
          "canonical_id",
          "name",
          "variants",
          "jv_links"
        ],
        "title": "SupplierCluster"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Variant": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "name",
          "source",
          "score"
        ],
        "title": "Variant"
      }
    }
  }
}
