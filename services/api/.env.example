PORT=4000
MONGO_URL=mongodb://localhost:27017/procurement
# Shared secret the web app sends as X-API-Key. Use a long random value outside local dev.
API_KEY=dev-key
GRAPH_SERVICE_URL=http://localhost:8000
GRAPH_API_KEY=dev-key
# Serve interactive API docs at /docs. Keep off on public deployments.
EXPOSE_DOCS=false
# Defaults to <repo>/data/seed
# SEED_DIR=
LOG_LEVEL=info
